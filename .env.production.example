APP_NAME="Nova Facturación"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://billing.example.com
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=postgres.example.com
DB_PORT=5432
DB_DATABASE=YOUR_DATABASE
DB_USERNAME=YOUR_USER
DB_PASSWORD=YOUR_PASSWORD
DB_TIMEZONE=America/Lima
DB_SSLMODE=require
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file
SESSION_DRIVER=file
SUNAT_PRODUCTION=true
WEBHOOK_ALLOW_UNSAFE_LOCAL=false
# SOL, certificado y OAuth GRE se configuran por empresa en la base cifrada.
# Emitir tokens propios mediante billing:credential; no existe token global.
