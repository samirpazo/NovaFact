        @page {
            margin: 8mm 10mm 8mm 12mm;
        }
        body {
            font-family: 'DejaVu Sans', sans-serif;
            font-size: 8.5pt;
            color: #111;
            line-height: 1.2;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        .header-table {
            width: 100%;
            margin-bottom: 8px;
        }
        .logo-cell {
            width: 60%;
            vertical-align: middle;
        }
        .ruc-cell {
            width: 40%;
            vertical-align: top;
        }
        .ruc-box {
            border: 2px solid #222;
            border-radius: 8px;
            padding: 10px;
            text-align: center;
        }
        .ruc-title {
            font-size: 13pt;
            font-weight: bold;
            margin-bottom: 4px;
        }
        .doc-name {
            font-size: 11pt;
            font-weight: bold;
            text-transform: uppercase;
            margin: 6px 0;
            letter-spacing: 0.5px;
        }
        .doc-number {
            font-size: 13pt;
            font-weight: bold;
        }
        .company-name {
            font-size: 11pt;
            font-weight: bold;
            margin-bottom: 3px;
            text-transform: uppercase;
        }
        .company-info {
            font-size: 7.5pt;
            color: #333;
            margin-bottom: 2px;
        }
        
        /* Client & Doc Info Box */
        .info-box {
            border: 1px solid #333;
            border-radius: 6px;
            padding: 6px 8px;
            margin-bottom: 8px;
        }
        .info-table td {
            padding: 2px 0;
            vertical-align: top;
        }
        
        /* Detail Items Table Box - Full Height Fill */
        .items-box {
            border: 1px solid #333;
            border-radius: 6px;
            overflow: hidden;
            margin-bottom: 8px;
            height: 560px;
        }
        .items-table {
            width: 100%;
            border-collapse: collapse;
            height: 100%;
        }
        .items-table th {
            background-color: #e0e0e0;
            border-bottom: 1px solid #333;
            border-right: 1px solid #333;
            padding: 6px 4px;
            font-size: 8pt;
            font-weight: bold;
            text-align: center;
            text-transform: uppercase;
            height: 20px;
        }
        .items-table th:last-child {
            border-right: none;
        }
        .items-table td {
            border-right: 1px solid #333;
            padding: 4px 5px;
            font-size: 8pt;
            vertical-align: top;
        }
        .items-table td:last-child {
            border-right: none;
        }
        .items-table tr.item-row td {
            border-bottom: 1px solid #eee;
        }
        .items-table tr.filler-row td {
            border-right: 1px solid #333;
            border-bottom: none;
            height: 100%;
        }
        .items-table tr.filler-row td:last-child {
            border-right: none;
        }
        
        /* Footer / Totals Section */
        .footer-table {
            width: 100%;
            margin-top: 4px;
        }
        .footer-left {
            width: 65%;
            vertical-align: top;
            padding-right: 10px;
        }
        .footer-right {
            width: 35%;
            vertical-align: top;
        }
        
        .box-rounded {
            border: 1px solid #333;
            border-radius: 6px;
            padding: 5px 8px;
            margin-bottom: 6px;
        }
        .words-text {
            font-size: 8pt;
            font-weight: bold;
            margin-bottom: 4px;
        }
        .payment-text {
            font-size: 8pt;
            font-weight: bold;
        }
        .obs-title {
            font-size: 8pt;
            font-weight: bold;
            margin-bottom: 2px;
        }
        .obs-content {
            font-size: 7.5pt;
            min-height: 24px;
        }
        
        /* Totals Table */
        .totals-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 8.5pt;
        }
        .totals-table td {
            padding: 4px 4px;
        }
        .totals-label {
            text-align: right;
            padding-right: 8px;
        }
        .totals-value {
            text-align: right;
            font-family: 'DejaVu Sans', sans-serif;
            width: 95px;
        }
        .totals-total-row td {
            font-size: 10pt;
            font-weight: bold;
            border-top: 1px solid #333;
            padding-top: 6px;
        }
        
        /* Payment cuotas table */
        .cuotas-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 7.5pt;
            margin-top: 4px;
            border: 1px solid #333;
        }
        .cuotas-table th {
            background-color: #f0f0f0;
            border: 1px solid #333;
            padding: 2px;
            text-align: center;
        }
        .cuotas-table td {
            border: 1px solid #333;
            padding: 2px;
            text-align: center;
        }
        
        /* Legal / QR section */
        .qr-table {
            width: 100%;
            margin-top: 6px;
        }
        .qr-img-cell {
            width: 75px;
            vertical-align: middle;
        }
        .qr-text-cell {
            vertical-align: middle;
            padding-left: 6px;
            font-size: 7pt;
            color: #444;
            line-height: 1.25;
        }

        /* Left margin rotated environmental text */
        .side-warning {
            position: absolute;
            left: -22px;
            bottom: 300px;
            transform: rotate(-90deg);
            transform-origin: 0 0;
            font-size: 7.5pt;
            color: #444;
            white-space: nowrap;
        }

        .header-table, .info-box, .qr-table { page-break-inside: avoid; }
        .items-table thead { display: table-header-group; }
        .items-table tr.item-row { page-break-inside: avoid; }
