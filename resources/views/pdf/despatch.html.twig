<!DOCTYPE html>
<html lang="es">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <style type="text/css">
        {% include 'assets/document.css.twig' %}
        .section-title { font-size: 8pt; font-weight: bold; margin-bottom: 4px; text-transform: uppercase; }
        .guide-info td { width: 50%; padding: 3px 4px 3px 0; overflow-wrap: break-word; }
        .guide-items { height: auto; min-height: 180px; }
        .guide-items .items-table { height: auto; }
        .guide-items .items-table td { border-bottom: 1px solid #eee; }
        .guide-footer { margin-top: 8px; }
    </style>
</head>
<body>
{% set cp = doc.company %}
{% set name = (doc.tipoDoc|catalog('01')) ~ ' ELECTRÓNICA' %}
{% include 'assets/document-header.html.twig' %}

{% if doc.tipoDoc == '31' and doc.tercero %}
<div class="info-box">
    <div class="section-title">Remitente</div>
    <table class="info-table guide-info"><tr>
        <td><strong>Razón social:</strong> {{ doc.tercero.rznSocial }}</td>
        <td><strong>{{ doc.tercero.tipoDoc|catalog('06') }}:</strong> {{ doc.tercero.numDoc }}</td>
    </tr></table>
</div>
{% endif %}
<div class="info-box">
    {% set cl = doc.destinatario %}
    <div class="section-title">Destinatario</div>
    <table class="info-table guide-info"><tr>
        <td><strong>Razón social:</strong> {{ cl.rznSocial }}</td>
        <td><strong>{{ cl.tipoDoc|catalog('06') }}:</strong> {{ cl.numDoc }}</td>
    </tr>{% if cl.address and cl.address.direccion %}<tr><td colspan="2"><strong>Dirección:</strong> {{ cl.address.direccion }}</td></tr>{% endif %}</table>
</div>
<div class="info-box">
    <div class="section-title">Datos del traslado</div>
    <table class="info-table guide-info">
        <tr><td><strong>Fecha de emisión:</strong> {{ doc.fechaEmision|date('d/m/Y') }}</td><td><strong>Inicio del traslado:</strong> {{ doc.envio.fecTraslado|date('d/m/Y') }}</td></tr>
        <tr><td><strong>Motivo:</strong> {{ doc.envio.codTraslado|catalog('20') }}</td><td><strong>Modalidad:</strong> {{ doc.envio.modTraslado|catalog('18') }}</td></tr>
        <tr><td><strong>Peso bruto total:</strong> {{ doc.envio.pesoTotal }} {{ doc.envio.undPesoTotal }}</td><td><strong>Bultos:</strong> {{ doc.envio.numBultos|default('-') }}</td></tr>
        <tr><td><strong>Punto de partida:</strong> {{ doc.envio.partida.ubigueo }} - {{ doc.envio.partida.direccion }}</td><td><strong>Punto de llegada:</strong> {{ doc.envio.llegada.ubigueo }} - {{ doc.envio.llegada.direccion }}</td></tr>
    </table>
</div>
{% set transportista = doc.envio.transportista %}
{% set vehiculo = doc.envio.vehiculo %}
{% set choferes = doc.envio.choferes %}
{% if transportista or vehiculo or choferes %}
<div class="info-box">
    <div class="section-title">Transporte</div>
    <table class="info-table guide-info">
        {% if transportista %}<tr><td><strong>Transportista:</strong> {{ transportista.rznSocial }}</td><td><strong>{{ transportista.tipoDoc|catalog('06') }}:</strong> {{ transportista.numDoc }}</td></tr>
        {% if transportista.nroMtc %}<tr><td colspan="2"><strong>Registro MTC:</strong> {{ transportista.nroMtc }}</td></tr>{% endif %}{% endif %}
        {% if vehiculo %}<tr><td colspan="2"><strong>Vehículo principal:</strong> {{ vehiculo.placa }}{% for secundario in vehiculo.secundarios %} · <strong>Secundario:</strong> {{ secundario.placa }}{% endfor %}</td></tr>{% endif %}
        {% for chofer in choferes %}<tr><td><strong>Conductor {{ chofer.tipo }}:</strong> {{ chofer.nombres }} {{ chofer.apellidos }}</td><td><strong>{{ chofer.tipoDoc|catalog('06') }}:</strong> {{ chofer.nroDoc }}{% if chofer.licencia %} · <strong>Licencia:</strong> {{ chofer.licencia }}{% endif %}</td></tr>{% endfor %}
    </table>
</div>
{% endif %}
<div class="items-box guide-items">
    <table class="items-table">
        <thead><tr><th width="7%">Ítem</th><th width="15%">Código</th><th width="53%">Descripción</th><th width="10%">U.M.</th><th width="15%">Cantidad</th></tr></thead>
        <tbody>{% for det in doc.details %}<tr class="item-row"><td align="center">{{ loop.index }}</td><td align="center">{{ det.codigo|default('-') }}</td><td>{{ det.descripcion }}</td><td align="center">{{ det.unidad }}</td><td align="right">{{ det.cantidad }}</td></tr>{% endfor %}</tbody>
    </table>
</div>
{% if doc.observacion %}<div class="box-rounded"><div class="obs-title">OBSERVACIONES:</div><div class="obs-content">{{ doc.observacion }}</div></div>{% endif %}
<div class="guide-footer">
    <table class="qr-table"><tr>
        {% if params.system.qr is defined %}<td class="qr-img-cell"><img src="{{ qrUrl(params.system.qr)|image_b64('svg+xml') }}" width="70" height="70" alt="QR de la guía" /></td>{% endif %}
        <td class="qr-text-cell"><strong>REPRESENTACIÓN IMPRESA DE LA {{ name }}</strong><br>
            {% if params.user.footer %}{{ params.user.footer }}<br>{% endif %}
            {% if params.system.qr is defined %}El QR contiene la URL de consulta recibida en el CDR.{% else %}Consulte el resultado fiscal y el CDR mediante la API.{% endif %}
        </td>
    </tr></table>
</div>
</body>
</html>
